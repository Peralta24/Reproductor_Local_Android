<?xml version="1.0" encoding="utf-8"?><!--
   SONIQ backs up library metadata and artwork, never private user audio.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="songs.json" />
        <include domain="file" path="playlists.json" />
        <include domain="file" path="AlbumArtwork/" />
        <include domain="file" path="PlaylistCovers/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="songs.json" />
        <include domain="file" path="playlists.json" />
        <include domain="file" path="AlbumArtwork/" />
        <include domain="file" path="PlaylistCovers/" />
    </device-transfer>
</data-extraction-rules>
