<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Catalogs, preferences and deduplicated artwork remain in cloud backup.
             Imported audio can be large and is locally re-importable, so keep it out
             of the limited app cloud-backup quota. -->
        <exclude domain="file" path="Songs/" />
    </cloud-backup>
    <device-transfer>
        <!-- A device-to-device migration preserves the complete private library. -->
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
