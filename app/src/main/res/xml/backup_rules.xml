<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Back up library metadata and artwork; never copy private user audio. -->
    <include domain="file" path="songs.json" />
    <include domain="file" path="playlists.json" />
    <include domain="file" path="AlbumArtwork/" />
    <include domain="file" path="PlaylistCovers/" />
</full-backup-content>
